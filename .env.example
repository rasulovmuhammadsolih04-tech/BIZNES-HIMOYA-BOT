# Bu fayldan shart emas: start.bat / start.sh birinchi ishga tushganda tokenni o'zi so'rab, .env yaratadi.
# Qo'lda qilmoqchi bo'lsangiz, shu faylni .env deb nusxalang va to'ldiring.

# @BotFather bergan token
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Murojaatlar keladigan guruh ID raqami (-100 bilan boshlanadi).
# Bilmasangiz: botni guruhga qo'shing va guruhda /id deb yozing — bot ID ni aytadi.
LEADS_CHAT_ID=
